{
  "name": "arkive-frontend",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pkill -9 -f 'uvicorn.*8200' 2>/dev/null; pkill -9 -f 'node.*5173' 2>/dev/null; sleep 2; npx playwright test",
    "test:e2e:ui": "pkill -9 -f 'uvicorn.*8200' 2>/dev/null; pkill -9 -f 'node.*5173' 2>/dev/null; sleep 2; npx playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "bits-ui": "^1.0.0-next.74",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.3.6"
  },
  "type": "module"
}
